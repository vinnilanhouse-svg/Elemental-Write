{
  "name": "elemental-write",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests *.json *.ts *.html README.md",
    "package:local": "npm run build && node scripts/package-local.mjs",
    "test:autosave": "node tests/autosave.mjs",
    "test:screenplay": "node tests/screenplay.mjs",
    "test:production": "node tests/production.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "docx": "^9.5.0",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.4.54",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
